  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "query": "label_values(up{job=\"fastapi-backend\"}, job)",
        "current": {
          "text": "fastapi-backend",
          "value": "fastapi-backend"
        },
        "type": "query",
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "refresh": 2,
        "sort": 1,
        "options": [],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "operation",
        "label": "Operation / feature",
        "query": "label_values(pms_operations_total{job=~\"$job\",instance=~\"$instance\"}, operation)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "channel",
        "label": "Channel",
        "type": "custom",
        "query": "rest,mcp",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "query": "label_values(pms_llm_calls_total{job=~\"$job\",instance=~\"$instance\"}, provider)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reading this view",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Provider calls count each explicit SDK invocation, including JSON fallback attempts. SDK-internal retries are hidden. Tokens count returned usage before response validation; estimates need usage and known pricing. Operation/feature and provider filters affect AI panels; channel applies only to operation panels. Case outcomes and pending ratings are aggregate across features/providers."
      }
    },
    {
      "id": 2,
      "title": "Provider calls \u00b7 selected period",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(pms_llm_calls_total{job=~\"$job\",instance=~\"$instance\",feature=~\"$operation\",provider=~\"$provider\"}[$__range]))) and on() (min(up{job=~\"$job\",instance=~\"$instance\"}) == 1)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
