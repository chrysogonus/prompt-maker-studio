        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(histogram_quantile(0.5,sum by (le,provider)(rate(pms_llm_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\",feature=~\"$operation\",provider=~\"$provider\"}[$__rate_interval])))) and on() (min(up{job=~\"$job\",instance=~\"$instance\"}) == 1)",
