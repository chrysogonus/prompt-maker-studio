          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(http_requests_total{job=~\"$job\",instance=~\"$instance\",status=~\"5..\"}[$__range])) or (0 * sum(increase(http_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__range])))) and on() (min(up{job=~\"$job\",instance=~\"$instance\"}) == 1)",
          "instant": true,
