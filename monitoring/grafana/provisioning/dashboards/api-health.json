  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "query": "label_values(up{job=\"fastapi-backend\"}, job)",
        "current": {
          "text": "fastapi-backend",
          "value": "fastapi-backend"
        },
        "type": "query",
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "refresh": 2,
        "sort": 1,
        "options": [],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "query": "label_values(up{job=~\"$job\"}, instance)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "operation",
        "label": "Operation / feature",
        "query": "label_values(pms_operations_total{job=~\"$job\",instance=~\"$instance\"}, operation)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "channel",
        "label": "Channel",
        "type": "custom",
        "query": "rest,mcp",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "query": "label_values(pms_llm_calls_total{job=~\"$job\",instance=~\"$instance\"}, provider)",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Reading this view",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "HTTP counts exclude `/` and `/metrics`; status labels are exact numeric strings and handlers are route templates. Overall API latency uses the high-resolution histogram (no route label). HTTP success can coexist with a partial evaluation or a rejected operation. In-progress work and resources are current gauges, not period totals."
      }
    },
    {
      "id": 2,
      "title": "HTTP requests \u00b7 selected period",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(http_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__range]))) and on() (min(up{job=~\"$job\",instance=~\"$instance\"}) == 1)",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      }
    },
    {
