    {
      "id": 12,
      "title": "Active operations \u00b7 selected period",
      "description": "Only active operation/outcome rows are shown, scoped to the selected channels. An empty table with healthy scrape status means no activity; headline totals still show initialized zeros.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (operation,outcome)(increase(pms_operations_total{job=~\"$job\",instance=~\"$instance\",operation=~\"$operation\",channel=~\"$channel\"}[$__range]))) and on() (min(up{job=~\"$job\",instance=~\"$instance\"}) == 1) > 0",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value": "Count"
            }
          }
        }
      ]
    },
