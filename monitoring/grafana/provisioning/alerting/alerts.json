{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "prompt-maker-studio",
      "folder": "Prompt Maker Studio",
      "interval": "30s",
      "rules": [
        {
          "uid": "pms-backendunavailable",
          "title": "BackendUnavailable",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "expr": "ALERTS{job=\"fastapi-backend\",alertname=\"BackendUnavailable\",alertstate=\"firing\"} or on(job,instance) (0 * up{job=\"fastapi-backend\"})",
                "instant": true,
                "range": false,
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.5
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ],
                "intervalMs": 15000,
                "maxDataPoints": 43200
              }
            }
          ],
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "for": "0s",
          "annotations": {
            "summary": "Backend metrics scrape unavailable or target missing",
            "description": "Check backend health, Prometheus targets and Docker networking. A missing target also fires this alert. Source: Prometheus ALERTS; configure an operator contact point and notification policy."
          },
          "labels": {
            "severity": "critical",
            "service": "prompt-maker-studio"
          },
          "isPaused": false
        },
        {
          "uid": "pms-sustainedservererrors",
          "title": "SustainedServerErrors",
