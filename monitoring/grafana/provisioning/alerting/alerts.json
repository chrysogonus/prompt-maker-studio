          "noDataState": "OK",
          "execErrState": "Alerting",
          "for": "0s",
          "annotations": {
            "summary": "Sustained HTTP 5xx rate above 5%",
            "description": "At least 100 requests in the last 5 minutes, above 5% 5xx for 5 minutes. Inspect sanitized route/status logs. Source: Prometheus ALERTS; configure an operator contact point and notification policy."
          },
          "labels": {
            "severity": "warning",
            "service": "prompt-maker-studio"
          },
          "isPaused": false
        },
