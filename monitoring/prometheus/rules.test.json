        {
          "expr": "(sum(increase(http_requests_total{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[24h]))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(sum(increase(http_requests_total{job=~\"fastapi-backend\",instance=~\"backend:8000\",status=~\"5..\"}[24h])) or (0 * sum(increase(http_requests_total{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[24h])))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(sum(pms_operations_in_progress{job=~\"fastapi-backend\",instance=~\"backend:8000\",operation=~\".*\"})) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(sum(increase(pms_snapshot_collection_errors_total{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[24h]))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
