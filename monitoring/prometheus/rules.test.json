          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(sum by (handler,method,status)(increase(http_requests_total{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[24h]))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(sum by (status)(rate(http_requests_total{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[1m]))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
          "eval_time": "5m",
          "exp_samples": []
        },
        {
          "expr": "(histogram_quantile(0.5,sum by (le)(rate(http_request_duration_highr_seconds_bucket{job=~\"fastapi-backend\",instance=~\"backend:8000\"}[1m])))) and on() (min(up{job=~\"fastapi-backend\",instance=~\"backend:8000\"}) == 1)",
